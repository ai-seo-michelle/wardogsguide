---
import { pageMatrixByRoute, type PageMatrixEntry } from "../data/pageMatrix";
import { guideContentByRoute } from "../data/pageContent";
import type { SeoEntry } from "../data/seo";
import PageMetaRail from "./PageMetaRail.astro";

type Props = {
  page: PageMatrixEntry;
  seo: SeoEntry;
};

const { page, seo } = Astro.props;
const content = guideContentByRoute[page.route];
const relatedPages = page.relatedRoutes
  .map((route) => pageMatrixByRoute[route])
  .filter(Boolean);
const quickAnswerParagraphs = content?.quickAnswer ?? [page.quickAnswer];
const sections = content?.sections ?? [];
const faqs = content?.faqs ?? [];
const sources = content?.sources ?? [];
const lastUpdated = content?.lastUpdated;
const editorOnlyCopyPattern = /^(Keep manual review|Keep this page as|Route explicit|Do not publish|Confirm final wording|Manual review is)/i;
const isPublicCopy = (text: string) => !editorOnlyCopyPattern.test(text.trim());
const publicSections = sections
  .map((section) => ({
    ...section,
    paragraphs: section.paragraphs?.filter(isPublicCopy),
    body: section.body && isPublicCopy(section.body) ? section.body : undefined,
    facts: section.facts?.filter((fact) => isPublicCopy(fact.text)),
    bullets: section.bullets?.filter(isPublicCopy)
  }))
  .filter((section) =>
    Boolean(
      section.body ||
        section.paragraphs?.length ||
        section.facts?.length ||
        section.bullets?.length ||
        section.links?.length
    )
  );
---

<section class="hero-band">
  <div class="hero hero--single">
    <div>
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{seo.h1}</h1>
      <p class="lead">{page.description}</p>
    </div>
  </div>
</section>

<div class:list={["page-frame", !lastUpdated && "page-frame--single"]}>
  <article class="content-stack">
    <section class="panel">
      <h2>Quick Answer</h2>
      {quickAnswerParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <div class="section-list">
      {
        publicSections.map((section) => (
          <section class="panel">
            <h2>{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.body && <p>{section.body}</p>}
            {
              section.facts && section.facts.length > 0 && (
                <ul class="facts-list">
                  {section.facts.map((fact) => (
                    <li>
                      <span class="fact-status">{fact.status}:</span>
                      <span>{fact.text}</span>
                    </li>
                  ))}
                </ul>
              )
            }
            {
              section.bullets && section.bullets.length > 0 && (
                <ul class="review-list">
                  {section.bullets.map((item) => <li>{item}</li>)}
                </ul>
              )
            }
            {
              section.links && (
                <ul class="link-grid">
                  {section.links.map((link) => (
                    <li>
                      <a class="guide-link" href={link.href}>
                        <strong>{link.label}</strong>
                        {link.description && <em>{link.description}</em>}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
          </section>
        ))
      }
    </div>

    {
      faqs.length > 0 && (
        <section class="panel">
          <h2>FAQ</h2>
          <div class="faq-list">
            {faqs.map((faq) => (
              <article class="faq-item">
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section class="panel">
      <h2>Related Guides</h2>
      <ul class="link-grid">
        {
          relatedPages.map((related) => (
            <li>
              <a class="guide-link" href={related.route}>
                <span>{related.type.replaceAll("_", " ")}</span>
                <strong>{related.title}</strong>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      sources.length ? (
        <section class="panel">
          <h2>Sources &amp; References</h2>
          <ul class="source-list">
            {sources.map((source) => (
              <li>
                <a href={source.url}>{source.label}</a>
                <span class="source-type"> {source.type}</span>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }
  </article>

  {lastUpdated && <PageMetaRail lastUpdated={lastUpdated} />}
</div>